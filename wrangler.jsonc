  "name": "nykst-software-intellegence",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Public configuration only. Secrets (SUPABASE_SERVICE_ROLE_KEY, GITHUB_CLIENT_SECRET,
  // NYKST_BYOK_SECRET, ...) live in the dashboard under Settings → Variables and secrets.
  "vars": {
    "SUPABASE_URL": "https://lpfjvufpibnxefqnispk.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_7XzrpmR_BfT53-68YjDYEA_g2e0ulbR",
    // OAuth App client id (public). Set GITHUB_APP_SLUG here instead to switch the
    // connect flow to a GitHub App; the two modes are mutually exclusive.
    "GITHUB_CLIENT_ID": "Ov23liop0HWjpzTRSmqj",
    "NYKST_ADMIN_GITHUB_ID": "297429012",
    "NYKST_AI_BASE_URL": "https://proxy.gonkabroker.com/v1",
    "NYKST_AI_MODEL": "deepseek-ai/DeepSeek-V4-Flash-0731"
  }
}
